{
  "name": "coderfleet-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoderFleet desktop and Node.js backend",
  "main": "dist/desktop.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/vendor.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "backend": "node dist/cli.js",
    "desktop": "electron .",
    "package": "npm run package:backend && electron-packager . CoderFleet --no-asar --out out --ignore='^/(src|test|out|scripts|backend|\\.cache|tsconfig.json|node_modules)'",
    "package:backend": "npm run build && node scripts/package-backend.mjs --arch x64 && node scripts/package-backend.mjs --arch arm64"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@electron/packager": "20.3.0",
    "@types/node": "22.20.5",
    "@xterm/xterm": "6.0.0",
    "electron": "45.4.1",
    "typescript": "5.9.3"
  }
}
